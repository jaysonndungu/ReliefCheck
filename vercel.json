{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build --workspace @reliefcheck/contracts && npm run build --workspace @reliefcheck/web && npm run check:bundle",
      "outputDirectory": "apps/web/dist",
      "rewrites": [
        { "source": "/appeal", "destination": "/index.html" },
        { "source": "/compare", "destination": "/index.html" },
        { "source": "/about", "destination": "/index.html" },
        { "source": "/sources/:id", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "npm --prefix ../.. run build --workspace @reliefcheck/contracts"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
