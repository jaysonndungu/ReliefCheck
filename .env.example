# Optional local API port. Also set it here when changing the dev proxy target.
PORT=3000

# US01 hosting: leave blank for local scaffolding. See docs/runbook.md.
# Request-handler role only (never the migration credential). Readiness reports
# DATABASE_UNCONFIGURED and staff routes return 503 while these are blank.
DATABASE_URL=
# Optional PEM CA bundle when the database TLS chain needs it.
DATABASE_CA_CERT=
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_JWKS_URL=

# Reserved for future server-side integrations. Leave blank for local scaffolding.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
SESSION_HMAC_SECRET=
